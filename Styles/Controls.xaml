<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- TOP WINDOW BUTTON STYLE -->
    <Style x:Key="WindowButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#A8C7E6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- PULSE BUTTON STYLE (tight, subtle borders) -->
    <Style x:Key="PulseButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#0F1A2B"/>
        <Setter Property="Foreground" Value="#4FFFEA"/>
        <Setter Property="BorderBrush" Value="#0C1826"/>
        <!-- darker border -->
        <Setter Property="BorderThickness" Value="0.5"/>
        <!-- thinner -->
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                         BorderBrush="{TemplateBinding BorderBrush}"
                         BorderThickness="{TemplateBinding BorderThickness}"
                         CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#142437"/>
                            <Setter Property="BorderBrush" Value="#4FFFEA"/>
                            <Setter Property="Foreground" Value="#7FFFFA"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#4FFFEA"/>
                            <Setter Property="Foreground" Value="#0F1A2B"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SLIDER STYLE -->
    <Style TargetType="Slider" x:Key="PulseSlider">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Margin="10,0,10,0">
                        <Border Height="4" Background="#23344D" CornerRadius="2"/>
                        <Border Height="4" Background="#4FFFEA" CornerRadius="2"
                             HorizontalAlignment="Left"
                             Width="{TemplateBinding Value}"/>
                        <Thumb Width="12" Height="12">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="#4FFFEA"
                                         BorderBrush="#0F1A2B"
                                         BorderThickness="2"
                                         CornerRadius="6"/>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>