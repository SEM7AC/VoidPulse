<Window x:Class="VoidPulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        Height="260" Width="350">

    <Window.Resources>

       

    </Window.Resources>

    <Border Background="#0F1A2B">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <!-- DRAG BAR -->
                <RowDefinition Height="40"/>
                <!-- TITLE -->
                <RowDefinition Height="120"/>
                <!-- VISUALIZER -->
                <RowDefinition Height="100"/>
                <!-- CONTROLS -->
            </Grid.RowDefinitions>

            <!-- DRAG BAR -->
            <Grid Grid.Row="0"
                  Background="Transparent"
                  MouseLeftButtonDown="Window_MouseDown">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,5,0">

                    <Button Content="_"
                            Width="22" Height="22"
                            Click="Minimize_Click"
                            Style="{StaticResource WindowButtonStyle}"/>

                    <Button Content="X"
                            Width="22" Height="22"
                            Click="Close_Click"
                            Style="{StaticResource WindowButtonStyle}"/>
                </StackPanel>
            </Grid>

            <!-- TITLE -->
            <TextBlock Grid.Row="1"
                       Text="VoidPulse"
                       FontSize="24"
                       FontFamily="Showcard Gothic"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#4FFFEA"
                                      BlurRadius="12"
                                      ShadowDepth="0"
                                      Opacity="0.6"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- VISUALIZER -->
            <Border Grid.Row="2"
                    Background="#0F1A2B"
                    Height="120"
                    ClipToBounds="True"
                    Margin="0,0,0,6">
                <Canvas x:Name="VisualizerCanvas"
                        Height="120"/>
            </Border>

            <!-- CONTROLS -->
            <Grid Grid.Row="3" VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Buttons -->
                    <RowDefinition Height="Auto"/>
                    <!-- Slider -->
                </Grid.RowDefinitions>

                <!-- BUTTONS -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,8">

                    <Button Content="⏮" Width="36" Height="36" Margin="3,0"
                            Style="{StaticResource PulseButtonStyle}"
                            Click="Prev_Button_Click"/>

                    <Button Content="⏹" Width="36" Height="36" Margin="3,0"
                            Style="{StaticResource PulseButtonStyle}"
                            Click="Stop_Button_Click"/>

                    <Button Content="⏯" Width="36" Height="36" Margin="3,0"
                            Style="{StaticResource PulseButtonStyle}"
                            Click="Play_Button_Click"
                            x:Name="PlayButton"/>

                    <Button Content="⏭" Width="36" Height="36" Margin="3,0"
                            Style="{StaticResource PulseButtonStyle}"
                            Click="Fwd_Button_Click"/>
                </StackPanel>

                <!-- SLIDER -->
                <Slider Grid.Row="1"
                        Style="{StaticResource PulseSlider}"
                        Minimum="0"
                        Maximum="100"
                        Margin="10,0,10,0"
                        VerticalAlignment="Top"/>
            </Grid>

        </Grid>

    </Border>
</Window>
